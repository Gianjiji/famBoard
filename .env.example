# Copy to .env and fill in. .env is gitignored and holds the only secret.
# Address of the Pi-hole (reached directly, no Proxmox).
PIHOLE_URL=https://192.168.1.46
# Pi-hole web/API password. Recommended: create a dedicated "application password"
# in the Pi-hole UI (Settings > Web interface / API) and use that here, not the admin one.
PIHOLE_PASSWORD=change-me
# The Pi-hole uses a self-signed TLS certificate, so verification is off by default.
PIHOLE_VERIFY_TLS=false
# Where the app stores its own SQLite database.
DB_PATH=data/famboard.db
# How often (seconds) the background poller pulls new data from the Pi-hole.
POLL_INTERVAL=60
# Conservazione dello storico: elimina gli eventi DNS più vecchi di N giorni
# (0 = conserva tutto, predefinito). Gli avvisi restano comunque. La dashboard
# guarda al massimo 30 giorni indietro: da 35 in su resta completa.
RETENTION_DAYS=0
# Device census CSV (backup of device labels, synced by census-sync/prune).
CENSUS_CSV=censimentoMAC/census.csv
# Dashboard login password. Leave empty to disable auth (trusted LAN only).
APP_PASSWORD=
# Session signing key. Leave empty to auto-generate and persist (data/.secret_key).
SECRET_KEY=
# Optional: webhook for minor alerts and weekly reports. e.g. https://ntfy.sh/my-topic
# Le push contengono nomi dei minori e categorie delicate: preferisci un ntfy
# self-hosted o un topic protetto da token (WEBHOOK_TOKEN), non uno pubblico.
WEBHOOK_URL=
# Bearer token per un webhook/ntfy protetto (vuoto = nessuna autenticazione).
WEBHOOK_TOKEN=
# Optional: SMTP for weekly reports by email (sent only if SMTP_HOST and SMTP_TO set).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
SMTP_TLS=true
# Report "attenzione" event-driven: secondi minimi tra due invii automatici
# (default 6h) e ogni quanto il poller rivaluta la situazione.
ATTENTION_MIN_INTERVAL=21600
ATTENTION_CHECK_INTERVAL=900
# Opzionale: LLM locale (endpoint OpenAI-compatibile, es. ollama/llama.cpp) per
# un riassunto di contesto in cima al report. Vuoto = disattivato.
AI_SUMMARY_URL=
AI_SUMMARY_MODEL=
AI_SUMMARY_KEY=
# Il riassunto invia nomi + categorie delicate: endpoint non locali sono
# rifiutati a meno di impostare esplicitamente questo a true.
AI_SUMMARY_ALLOW_REMOTE=false
# Throttling del login: tentativi falliti max e durata del blocco (secondi).
LOGIN_MAX_ATTEMPTS=8
LOGIN_COOLDOWN_S=300
